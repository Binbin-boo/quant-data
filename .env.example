# 环境变量模板
# 复制为 .env，填入真实值（.env 已加入 .gitignore，不会被提交）
#
# 学习要点 - 为什么用 .env.example 而不是直接用 .env？
#   .env 含有真实密钥，绝对不能进 git。
#   .env.example 是空模板，安全提交，让团队成员知道需要配置哪些变量。
#   这是所有开源项目的标准实践。

# ── Cloudflare R2（推荐） ──────────────────────────────────────
# 获取步骤：Cloudflare 控制台 → R2 → 管理 R2 API 令牌
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=quant-data

# ── AWS S3（备选） ────────────────────────────────────────────
# 获取步骤：AWS 控制台 → IAM → 创建用户 → 附加 AmazonS3FullAccess 策略
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# S3_BUCKET_NAME=quant-data
